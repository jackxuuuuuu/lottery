.container {
  display: flex;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 60rpx;
}

.draw-btn {
  width: 100%;
  padding: 28rpx 0;
  font-size: 32rpx;
  background: #e74c3c;
  color: #fff;
  border-radius: 16rpx;
  border: none;
}

.draw-btn[disabled] {
  opacity: 0.6;
}

.result {
  margin-top: 60rpx;
  text-align: center;
}

.prize {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #e74c3c;
  margin-bottom: 16rpx;
}

.message {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.error {
  margin-top: 40rpx;
  color: #e74c3c;
  font-size: 28rpx;
  text-align: center;
}
